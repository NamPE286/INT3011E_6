{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "int3011e-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "int3011e-db",
      "database_id": "71b70cb7-d61d-49d6-b4ae-3b380d1494ed",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILE_STORAGE",
      "bucket_name": "int3011e-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "PROCESSING_QUEUE",
        "queue": "pdf-convert"
      }
    ],
    "consumers": [
      {
        "queue": "pdf-convert",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1,
        "dead_letter_queue": "pdf-convert-dlq"
      }
    ]
  }
}
