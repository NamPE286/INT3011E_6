    "elysia": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "bun-types": "latest",
    "typescript": "^7.0.2",
    "wrangler": "^4.136.3"
  },
  "module": "src/index.js"
}
