        {
            "id": "nd-100-2019",
            "title": "NGHỊ ĐỊNH Quy định xử phạt vi phạm hành chính trong lĩnh vực giao thông đường bộ và đường sắt",
            "content": "CHÍNH PHỦ\nSố: 100/2019/NĐ-CP\nHà Nội, ngày 30 tháng 12 năm 2019\nCăn cứ Luật Xử lý vi phạm hành chính ngày 20 tháng 6 năm 2012;",
            "articles": [
                {
                    "number": "5",
                    "title": "Xử phạt người điều khiển xe ô tô và các loại xe tương tự xe ô tô vi phạm quy tắc giao thông đường bộ",
                    "clauses": [
                        {
                            "number": "5",
                            "content": "Phạt tiền từ 3.000.000 đồng đến 5.000.000 đồng đối với người điều khiển xe thực hiện một trong các hành vi vi phạm sau đây:",
                            "points": [
                                {
                                    "number": "a",
                                    "content": "Không chấp hành hiệu lệnh của đèn tín hiệu giao thông;"
                                },
                                {
                                    "number": "b",
                                    "content": "Không chấp hành hiệu lệnh, hướng dẫn của người điều khiển giao thông hoặc người kiểm soát giao thông;"
                                }
                            ]
                        },
                        {
                            "number": "11",
                            "content": "Ngoài việc bị phạt tiền, người điều khiển xe thực hiện hành vi vi phạm còn bị áp dụng các hình thức xử phạt bổ sung sau đây:",
                            "points": [
                                {
                                    "number": "a",
                                    "content": "Thực hiện hành vi quy định tại điểm a, điểm b khoản 5 Điều này bị tước quyền sử dụng Giấy phép lái xe từ 01 tháng đến 03 tháng;"
                                }
                            ]
                        }
                    ]
                },
                {
                    "number": "6",
                    "title": "Xử phạt người điều khiển xe mô tô, xe gắn máy vi phạm quy tắc giao thông đường bộ",
                    "clauses": [
                        {
                            "number": "4",
                            "content": "Phạt tiền từ 600.000 đồng đến 1.000.000 đồng đối với người điều khiển xe thực hiện một trong các hành vi vi phạm sau đây:",
                            "points": [
                                {
                                    "number": "e",
                                    "content": "Không chấp hành hiệu lệnh của đèn tín hiệu giao thông;"
                                },
                                {
                                    "number": "i",
                                    "content": "Chạy trong hầm đường bộ không sử dụng đèn chiếu sáng gần;"
                                }
                            ]
                        }
                    ]
                },
                {
                    "number": "86",
                    "title": "Hiệu lực thi hành",
                    "clauses": [
                        {
                            "number": "1",
                            "content": "Nghị định này có hiệu lực thi hành kể từ ngày 01 tháng 01 năm 2020."
                        },
                        {
                            "number": "2",
                            "content": "Nghị định số 46/2016/NĐ-CP ngày 26 tháng 5 năm 2016 của Chính phủ hết hiệu lực kể từ ngày Nghị định này có hiệu lực thi hành."
                        }
                    ]
                }
            ]
        },
